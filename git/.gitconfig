[user]
    # Identity (name, email, signingkey) lives in ~/.config/git/config.local,
    # written by setup.sh on first install. That file is intentionally not in
    # this repo. With commit.gpgsign = true and no signingkey set, commits
    # will fail loudly until config.local is in place — that's intentional.

[include]
    path = ~/.config/git/config.local

[gpg]
    format = ssh

[gpg "ssh"]
    # Populate ~/.config/git/allowed_signers with lines like:
    #   you@example.com namespaces="git" ssh-ed25519 AAAA...
    # so `git log --show-signature` can verify your own commits locally.
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram

[merge]
    conflictStyle = zdiff3

[fetch]
    prune = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[color]
    ui = auto

[alias]
    st = status
    co = checkout
    ci = commit
    lg = log --graph --oneline --decorate --all

# Credential helpers (preserved from `gh auth setup-git`).
# Empty `helper =` clears any inherited helpers, then gh provides credentials.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
